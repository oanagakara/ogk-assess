# Required in all environments
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Set to False in production. Omit or set False on Render.
DEBUG=False

# Comma-separated list of allowed hostnames. Example: myapp.onrender.com,www.myapp.com
ALLOWED_HOSTS=

# Tenant slug — must match the slug field of an active Tenant record in the database.
# Defaults to "default" if unset (local dev only).
TENANT_SLUG=default

# PostgreSQL connection string (provided by Render database binding).
# If unset, Django falls back to local SQLite (development only).
DATABASE_URL=

# Admin interface URL prefix (without trailing slash). Default: _platform-admin
# Change this per deployment to obscure the admin path.
ADMIN_URL_PREFIX=_platform-admin

# Anthropic API key — required if AI marking is active
ANTHROPIC_API_KEY=

# Superuser bootstrap (used by build.sh on first deploy — mark Secret in Render)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
